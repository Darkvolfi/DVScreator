<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ yedekleme kuralları (Android 11 ve öncesi: backup_rules.xml — ikisi aynı tutulmalı).
     wa_packs/: paketler (pack.json + WebP + simge) — kullanıcının asıl verisi.
     sources/: orijinal görseller/videolar, yalnızca cihazdan cihaza aktarımda. Bulut yedeğinin uygulama başına
     25 MB sınırı var; aşılırsa yedeğin TAMAMI atlanıyor — videolar bu sınırı kolayca aşar.
     Önbellek ve ayarlar (klasör izinleri, klavye geçmişi) yedeklenmez: izinler yeni cihaza taşınmıyor. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="wa_packs/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="wa_packs/" />
        <include domain="file" path="sources/" />
    </device-transfer>
</data-extraction-rules>
