<?xml version="1.0" encoding="utf-8"?>
<!-- Yedeklemeye yalnızca orijinal görseller, düzenleme tarifleri ve veritabanı girer;
     WebP çıktıları orijinalden yeniden üretilebildiği için yedeklenmez. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="sources/" />
        <include domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="sources/" />
        <include domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
