<?xml version="1.0" encoding="utf-8"?>
<!-- Kıvrık köşeli sticker üzerinde ":3" yüzü (":" gözler, "3" ağız → • • / ω). Yüz 45° döndürülmüş:
     ağız kıvrık köşenin katlanma çizgisine paralel, köşenin hemen üstünde — sticker köşesine bakıyormuş gibi.
     Adaptive icon güvenli alanı: 108 dp içinde merkezdeki 66 dp (21..87). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Sticker -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M32,28h44a4,4 0,0 1,4 4v28l-20,20h-28a4,4 0,0 1,-4 -4v-44a4,4 0,0 1,4 -4z" />
    <!-- Kıvrık köşe -->
    <path
        android:fillColor="#C8EBD9"
        android:pathData="M80,60h-16a4,4 0,0 0,-4 4v16z" />
    <!-- Yüz: yerel koordinatlarda merkez (0,0), ağız merkezi (0,6); döndürülüp köşeye taşınır -->
    <group
        android:rotation="-45"
        android:translateX="50.5"
        android:translateY="50.5">
        <!-- ":" → gözler -->
        <path
            android:fillColor="#1B8A5A"
            android:pathData="M-9,-8m-4,0a4,4 0,1 1,8 0a4,4 0,1 1,-8 0" />
        <path
            android:fillColor="#1B8A5A"
            android:pathData="M9,-8m-4,0a4,4 0,1 1,8 0a4,4 0,1 1,-8 0" />
        <!-- "3" → ω ağız -->
        <path
            android:pathData="M-11,4q5,9 11,0q6,9 11,0"
            android:strokeWidth="3.5"
            android:strokeColor="#1B8A5A"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
    </group>
    <!-- Test sürümü işareti: sağ üstte yuvarlak köşeli sarı üçgen ve ünlem (koyu kenar beyaz stickerdan ayırır) -->
    <path
        android:fillColor="#212121"
        android:strokeColor="#212121"
        android:strokeWidth="8"
        android:strokeLineJoin="round"
        android:pathData="M70,25L82,46H58Z" />
    <path
        android:fillColor="#FFC107"
        android:strokeColor="#FFC107"
        android:strokeWidth="4"
        android:strokeLineJoin="round"
        android:pathData="M70,25L82,46H58Z" />
    <path
        android:strokeColor="#212121"
        android:strokeWidth="3.2"
        android:strokeLineCap="round"
        android:pathData="M70,31.5V38.5" />
    <path
        android:fillColor="#212121"
        android:pathData="M70,44m-1.9,0a1.9,1.9 0,1 1,3.8 0a1.9,1.9 0,1 1,-3.8 0" />
</vector>
